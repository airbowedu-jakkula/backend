# ---- Runtime ----
NODE_ENV=development
PORT=5000
# Comma-separated browser origins allowed to call the API. * for dev.
ALLOWED_ORIGINS=*

# ---- Database (required) ----
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/visaslots

# ---- Auth (required) ----
JWT_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# ---- Chrome/Edge extension ----
EXTENSION_API_KEY=replace_with_a_long_random_string

# ---- Telegram (optional — alerts disabled if unset) ----
TELEGRAM_BOT_TOKEN=your_botfather_token
# One channel per category group; blank ones fall back to TELEGRAM_CHAT_ID_DEFAULT.
TELEGRAM_CHAT_ID_B1B2=
TELEGRAM_CHAT_ID_F1F2=
TELEGRAM_CHAT_ID_H1BH4=
TELEGRAM_CHAT_ID_DEFAULT=-1001234567890
